# AI Staff HQ Configuration

# OpenRouter Configuration (Recommended)
# Get your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Provider Specific Keys (Optional Fallbacks)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Model Configuration
DEFAULT_MODEL=nvidia/nemotron-3-super-120b-a12b:free
DEFAULT_TEMPERATURE=0.7
REQUEST_TIMEOUT_SECONDS=120
MAX_RETRIES=2

# Agent Settings
MAX_HISTORY_TURNS=20
MAX_CONTEXT_TOKENS=32000
# Interaction logs are opt-in. When enabled, credential-shaped values are
# redacted and log files are written atomically with 0600 permissions.
ENABLE_LOGGING=false

# System
DEBUG=false
RICH_OUTPUT=true
